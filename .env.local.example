# Base de données MySQL (partagée avec le serveur FiveM)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=epsilon

# Auth.js
# Générer avec: npx auth secret
AUTH_SECRET=

# Discord OAuth (discord.com/developers/applications)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ID du serveur Discord Epsilon Roleplay (clic droit sur le serveur en mode
# développeur > Copier l'ID). Sert à vérifier que l'utilisateur est bien
# membre du serveur avant de le laisser candidater.
DISCORD_GUILD_ID=

# IDs Discord des administrateurs (séparés par des virgules)
# Clic droit sur un utilisateur en mode développeur > Copier l'ID
ADMIN_DISCORD_IDS=

# Twitch OAuth (dev.twitch.tv/console/apps)
# Redirect URI à enregistrer : http://localhost:3000/api/twitch/callback (dev)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/callback
